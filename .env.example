# Public canonical URL for production
NEXT_PUBLIC_SITE_URL=https://dsa.quiiktool.com
# Optional Search Console HTML tag verification token (not an API key)
GOOGLE_SITE_VERIFICATION=

# AdSense: leave disabled while IDs are missing or approval is pending
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_PUB_ID=
# Responsive display unit
NEXT_PUBLIC_ADSENSE_TOP_BANNER_SLOT=
# Native in-article unit
NEXT_PUBLIC_ADSENSE_CONTENT_SLOT=
# Responsive display/rectangle unit for wide desktop layouts
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
# Responsive display unit for the end of browse pages
NEXT_PUBLIC_ADSENSE_FEED_SLOT=
